<Window x:Class="TaskFirst.UI.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskFirst"
        SizeToContent="Height" Width="360"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Topmost="True">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Text="Enter your password" Foreground="{StaticResource Fg}"
                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <PasswordBox x:Name="Pwd" FontSize="14" Padding="6,4" Background="{StaticResource Panel}"
                     Foreground="{StaticResource Fg}" KeyDown="OnKey"/>
        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource AccentRed}"
                   FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancel" Padding="14,6" Margin="0,0,8,0"
                    Background="#3A3D4A" Foreground="{StaticResource Fg}" BorderThickness="0"/>
            <Button Content="OK" Click="OnOk" Padding="14,6"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
