<Window x:Class="TaskFirst.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskFirst.UI"
        Title="TaskFirst"
        Height="760" Width="1080"
        MinHeight="640" MinWidth="900"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3D4A"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="2,0,2,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Accent}" Margin="0,0,12,0">
                    <TextBlock Text="✓" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="TaskFirst" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Turn progress into access" Foreground="{StaticResource FgDim}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="ProBadge" CornerRadius="10" Padding="10,3" Margin="0,0,8,0"
                        Background="{StaticResource Panel}">
                    <TextBlock x:Name="ProBadgeText" Text="FREE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource FgDim}"/>
                </Border>
                <Button x:Name="UpgradeBtn" Content="Upgrade to Pro" Click="OnUpgrade"
                        Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- Left: rules list -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,2,4,14">
                    <TextBlock Text="Your rules" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose what unlocks, and when." FontSize="12" Foreground="{StaticResource FgDim}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+ Add" Click="OnAddRule"/>
                    <Button Content="Delete" Click="OnDeleteRule" Background="#4A2A2A"/>
                </StackPanel>
                <ListBox x:Name="RulesList" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Fg}"
                         SelectionChanged="OnRuleSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="●" Margin="0,0,6,0"
                                           Foreground="{Binding Enabled, Converter={x:Static local:BoolDotConverter.Instance}}"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: editor -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel" IsEnabled="False">
                    <TextBlock Text="Rule setup" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Define the apps to pause and the goals that release them." Foreground="{StaticResource FgDim}" Margin="0,4,0,10"/>
                    <TextBlock Text="Rule name" Style="{StaticResource Label}"/>
                    <TextBox x:Name="NameBox"/>
                    <CheckBox x:Name="EnabledBox" Content="Rule enabled" Click="OnRuleEnabledToggled"/>

                    <TextBlock Text="App / process names to block (one per line, e.g. chrome, steam)"
                               Style="{StaticResource Label}"/>
                    <TextBox x:Name="ProcBox" AcceptsReturn="True" Height="64"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

                    <TextBlock Text="Only when window title contains (optional, one per line)"
                               Style="{StaticResource Label}"/>
                    <TextBox x:Name="TitleBox" AcceptsReturn="True" Height="48"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

                    <Border Height="1" Background="#3A3D4A" Margin="0,16,0,4"/>
                    <TextBlock Text="UNLOCK GOALS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" Margin="0,10,0,3"/>
                    <TextBlock Text="All goals you add must be completed. Mix integrations to build a rule that fits you."
                               Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <CheckBox x:Name="GateEnabledBox" Content="Allow this rule to unlock when all goals are complete"/>

                    <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Focus sessions" FontWeight="SemiBold"/>
                                <TextBlock Text="Complete Pomodoros in the TaskFirst timer." Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sessions required" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                                <TextBox x:Name="MinPomosBox" Text="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,2">
                    <StackPanel>
                    <TextBlock Text="Anki" FontWeight="SemiBold"/>
                    <TextBlock Text="Optional · use reviewed cards or a cleared deck as a goal." Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,3,0,2"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Deck (blank = all decks)" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="DeckBox" IsEditable="True"
                                      Background="{StaticResource Panel}" Foreground="Black"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Min cards today" Style="{StaticResource Label}"/>
                            <TextBox x:Name="MinCardsBox" Text="100"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ClearedBox" Content="Also require the deck to be fully cleared (0 due)"/>

                    <TextBlock Text="AnkiConnect URL" Style="{StaticResource Label}"/>
                    <TextBox x:Name="UrlBox" Text="http://127.0.0.1:8765"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Load decks from Anki" Click="OnLoadDecks"/>
                        <Button Content="Test now" Click="OnTestGate" Background="{StaticResource Accent}"/>
                    </StackPanel>
                    <TextBlock x:Name="TestResult" Text="" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource FgDim}"/>
                    </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,0" Opacity="0.7">
                        <Grid>
                            <StackPanel><TextBlock Text="More integrations" FontWeight="SemiBold"/><TextBlock Text="App time, habits, health and custom goals are next." Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource PanelRaised}" CornerRadius="9" Padding="10,4"><TextBlock Text="COMING SOON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FgDim}"/></Border>
                        </Grid>
                    </Border>

                    <Border Height="1" Background="#3A3D4A" Margin="0,16,0,4"/>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="SCHEDULE" FontSize="11" Foreground="{StaticResource Accent}"/>
                        <TextBlock x:Name="SchedProTag" Text="PRO" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="#C9A24B"/>
                    </Grid>
                    <StackPanel x:Name="SchedulePanel">
                        <CheckBox x:Name="SchedEnabledBox" Content="Only block during these hours/days"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="DaySu" Content="Su" Margin="0,0,8,0"/>
                            <CheckBox x:Name="DayMo" Content="Mo" Margin="0,0,8,0"/>
                            <CheckBox x:Name="DayTu" Content="Tu" Margin="0,0,8,0"/>
                            <CheckBox x:Name="DayWe" Content="We" Margin="0,0,8,0"/>
                            <CheckBox x:Name="DayTh" Content="Th" Margin="0,0,8,0"/>
                            <CheckBox x:Name="DayFr" Content="Fr" Margin="0,0,8,0"/>
                            <CheckBox x:Name="DaySa" Content="Sa"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource FgDim}"/>
                            <TextBox x:Name="StartTimeBox" Text="09:00" Width="64"/>
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0,6,0"
                                       Foreground="{StaticResource FgDim}"/>
                            <TextBox x:Name="EndTimeBox" Text="17:00" Width="64"/>
                            <TextBlock Text="(24h, overnight ranges ok)" VerticalAlignment="Center"
                                       Margin="8,0,0,0" FontSize="10" Foreground="{StaticResource FgDim}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom bar -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="MasterBlockBox" Content="Blocking active" VerticalAlignment="Center"
                          Margin="0,0,16,0" Click="OnToggleMaster"/>
                <CheckBox x:Name="StartupBox" Content="Start with Windows (admin)" VerticalAlignment="Center"
                          Margin="0,0,16,0" Click="OnToggleStartup"/>
                <CheckBox x:Name="TamperBox" Content="🔒 Tamper-lock" VerticalAlignment="Center"
                          Margin="0,0,4,0" Click="OnToggleTamper"
                          ToolTip="Pro: require a password to disable blocking or quit."/>
                <Button Content="Set password" Click="OnSetTamperPassword" Padding="8,4" Margin="0,0,16,0"/>
                <Button Content="Show Pomodoro" Click="OnShowPomodoro"/>
                <Button Content="Refresh goals" Click="OnRecheck"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource FgDim}"/>
                <Button Content="Save" Click="OnSave" Background="{StaticResource AccentGreen}"
                        Foreground="#10240F" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
