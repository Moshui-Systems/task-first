<Window x:Class="TaskFirst.UI.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskFirst — Upgrade to Pro"
        Height="520" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3D4A"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="TaskFirst Pro" FontSize="24" FontWeight="Bold"/>
        <Border x:Name="StatusBadge" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                Background="{StaticResource Panel}" HorizontalAlignment="Left">
            <TextBlock x:Name="StatusText" Text="Free tier" FontWeight="SemiBold"/>
        </Border>

        <TextBlock Text="Pro unlocks" Margin="0,18,0,6" Foreground="{StaticResource Accent}" FontSize="12"/>
        <StackPanel>
            <TextBlock Text="✓  Unlimited blocking rules (Free: 2)" Margin="0,2"/>
            <TextBlock Text="✓  Schedules — block only during set hours/days" Margin="0,2"/>
            <TextBlock Text="✓  Tamper-lock — password required to disable blocking or quit" Margin="0,2"/>
            <TextBlock Text="✓  Priority support &amp; future Pro gates" Margin="0,2"/>
        </StackPanel>

        <Border Height="1" Background="#3A3D4A" Margin="0,18"/>

        <TextBlock Text="Paste your license key" FontSize="12" Foreground="{StaticResource FgDim}"/>
        <TextBox x:Name="KeyBox" AcceptsReturn="True" Height="90" Margin="0,6,0,0"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
                 BorderBrush="#3A3D4A" BorderThickness="1" Padding="6" FontFamily="Consolas" FontSize="11"
                 CaretBrush="{StaticResource Fg}"/>
        <TextBlock x:Name="Message" Text="" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource FgDim}"/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Activate" Click="OnActivate" Background="{StaticResource AccentGreen}"
                    Foreground="#0F240F" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button x:Name="DeactivateBtn" Content="Deactivate" Click="OnDeactivate" Margin="0,0,8,0"/>
            <Button Content="Buy a license →" Click="OnBuy" Background="{StaticResource Accent}"
                    Foreground="White"/>
        </StackPanel>

        <TextBlock Text="After purchase, your key is emailed to you — paste it above and click Activate."
                   Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource FgDim}"/>

        <TextBlock x:Name="DeviceText" Text="" Margin="0,10,0,0" FontSize="10"
                   Foreground="{StaticResource FgDim}"/>
    </StackPanel>
</Window>
