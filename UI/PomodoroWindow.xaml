<Window x:Class="TaskFirst.UI.PomodoroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="OnDrag">

    <Window.Resources>
        <Style TargetType="Button" x:Key="Pill">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="#3A3D4A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#F01E1F26" Padding="16" Width="240">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock x:Name="PhaseLabel" Text="FOCUS" FontWeight="Bold" FontSize="13"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsBtn" Content="⚙" Style="{StaticResource Pill}"
                            Background="Transparent" FontSize="14" Click="OnSettings" ToolTip="Settings"/>
                    <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource Pill}"
                            Background="Transparent" FontSize="12" Click="OnHide" ToolTip="Hide widget"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TimeLabel" Text="25:00" FontSize="52" FontWeight="Light"
                       Foreground="{StaticResource Fg}" HorizontalAlignment="Center" Margin="0,4,0,6"/>

            <Border Height="6" CornerRadius="3" Background="#3A3D4A">
                <Border x:Name="ProgressFill" Height="6" CornerRadius="3" Width="0"
                        HorizontalAlignment="Left" Background="{StaticResource Accent}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,4">
                <Button x:Name="StartBtn" Content="Start" Style="{StaticResource Pill}"
                        Background="{StaticResource Accent}" Click="OnStartPause"/>
                <Button Content="Skip" Style="{StaticResource Pill}" Click="OnSkip"/>
                <Button Content="Reset" Style="{StaticResource Pill}" Click="OnReset"/>
            </StackPanel>

            <Grid Margin="0,10,0,0">
                <TextBlock x:Name="SessionLabel" Text="Sessions: 0" FontSize="11"
                           Foreground="{StaticResource FgDim}"/>
                <TextBlock x:Name="AnkiLabel" Text="Anki: —" FontSize="11"
                           Foreground="{StaticResource FgDim}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
