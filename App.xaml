<Application x:Class="TaskFirst.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1E1F26"/>
        <SolidColorBrush x:Key="Panel" Color="#2A2C36"/>
        <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3FD07A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="Fg" Color="#F2F3F7"/>
        <SolidColorBrush x:Key="FgDim" Color="#9AA0B4"/>
    </Application.Resources>
</Application>
