<Application x:Class="TaskFirst.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#101218"/>
        <SolidColorBrush x:Key="Panel" Color="#1A1D26"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#222633"/>
        <SolidColorBrush x:Key="Line" Color="#303545"/>
        <SolidColorBrush x:Key="Accent" Color="#6C7CFF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4ADE80"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="Fg" Color="#F2F3F7"/>
        <SolidColorBrush x:Key="FgDim" Color="#9299AD"/>
    </Application.Resources>
</Application>
